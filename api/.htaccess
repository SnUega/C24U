# Включение mod_rewrite
RewriteEngine On

# Разрешить доступ к файлам напрямую (для payments.json, logs и т.д.)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Роутинг API запросов
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]

# Безопасность: запретить доступ к файлам конфигурации
<FilesMatch "\.(env|json|log)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Разрешить доступ только к index.php
<Files "index.php">
    Order allow,deny
    Allow from all
</Files>

# Установка переменных окружения (альтернатива .env файлу)
# Раскомментируйте и укажите свои значения:
# SetEnv YOOKASSA_SHOP_ID "ваш_shop_id"
# SetEnv YOOKASSA_SECRET_KEY "ваш_секретный_ключ"
# SetEnv TELEGRAM_BOT_TOKEN "ваш_токен_бота"
# SetEnv TELEGRAM_CHANNEL_ID "ваш_id_канала"
# SetEnv FRONTEND_URL "https://your-site.com"

# Включение CORS (если frontend на другом домене)
# Header set Access-Control-Allow-Origin "*"
# Header set Access-Control-Allow-Methods "POST, GET, OPTIONS"
# Header set Access-Control-Allow-Headers "Content-Type, Authorization"

