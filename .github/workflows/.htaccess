# ========== КЭШИРОВАНИЕ СТАТИЧЕСКИХ ФАЙЛОВ ==========

# Включаем кэширование для изображений
<IfModule mod_expires.c>
  ExpiresActive On
  
  # Изображения - кэш на 1 год
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  
  # CSS и JavaScript - кэш на 1 месяц
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/x-javascript "access plus 1 month"
  
  # Шрифты - кэш на 1 год
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  
  # HTML - кэш на 1 час (чтобы обновления быстро появлялись)
  ExpiresByType text/html "access plus 1 hour"
  
  # XML файлы (sitemap) - кэш на 1 день
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/xml "access plus 1 day"
</IfModule>

# ========== СЖАТИЕ GZIP (если поддерживается) ==========
<IfModule mod_deflate.c>
  # Сжимаем HTML, CSS, JavaScript, Text, XML
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ========== ЗАГоловки кэширования ==========
<IfModule mod_headers.c>
  # Кэш для CSS и JS
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  
  # Кэш для изображений
  <FilesMatch "\.(jpg|jpeg|png|gif|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  
  # Кэш для шрифтов
  <FilesMatch "\.(woff|woff2|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>

# ========== БЕЗОПАСНОСТЬ ==========
# Запрещаем доступ к скрытым файлам
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>

# Защита от просмотра директорий
Options -Indexes

# ========== ЗАГОЛОВКИ БЕЗОПАСНОСТИ ==========
<IfModule mod_headers.c>
  # Защита от clickjacking (запрет встраивания в iframe)
  Header always set X-Frame-Options "SAMEORIGIN"
  
  # Защита от MIME-sniffing
  Header always set X-Content-Type-Options "nosniff"
  
  # Защита от XSS в старых браузерах
  Header always set X-XSS-Protection "1; mode=block"
  
  # Контроль реферера
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  
  # Permissions Policy (ограничение доступа к API браузера)
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), browsing-topics=()"
  
  # HSTS - принудительный HTTPS (раскомментировать после проверки SSL)
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ========== КРАСИВЫЕ URL (без .html) ==========
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # ИСКЛЮЧЕНИЕ: Не обрабатывать запросы к папке api/ (она имеет свой .htaccess)
  RewriteCond %{REQUEST_URI} ^/api/ [NC]
  RewriteRule ^ - [L]
  
  # Если запрос не файл и не директория
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  
  # Перенаправляем /page на /page.html
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([^/]+)/?$ $1.html [L]
  
  # Убираем .html из URL (301 редирект)
  RewriteCond %{THE_REQUEST} /([^.]+)\.html [NC]
  RewriteRule ^ /%1 [R=301,L]
</IfModule>

# ========== ПЕРЕНАПРАВЛЕНИЯ ==========
# Принудительно HTTPS (закомментировано - Timeweb управляет SSL редиректами автоматически)
# Если нужен ручной редирект, раскомментируйте:
# RewriteCond %{HTTPS} off
# RewriteCond %{HTTP:X-Forwarded-Proto} !https
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ========== ДОСТУП К ФАЙЛАМ ==========
# Разрешаем доступ к robots.txt и sitemap.xml
<FilesMatch "^(robots\.txt|sitemap\.xml)$">
  Order allow,deny
  Allow from all
</FilesMatch>
